# Command Center — required in production (Vercel)
COMMAND_CENTER_USERNAME=
COMMAND_CENTER_PASSWORD=

# Optional: writable SQLite file path in production.
# On Vercel, defaults to /tmp/lunov-command-center.db (ephemeral per instance).
# For persistent data, point this to a mounted volume on your host.
COMMAND_CENTER_DB_PATH=

# Optional: one-time restore of SQLite backup when db file is missing (private URL).
COMMAND_CENTER_DB_BACKUP_URL=
